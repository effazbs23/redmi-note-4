<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="group_operations_lead" model="res.groups">
        <field name="name">Operations Lead</field>
        <field name="implied_ids" eval="[
            (4, ref('stock.group_stock_manager')),
            (4, ref('mrp.group_mrp_manager')),
            (4, ref('purchase.group_purchase_manager')),
        ]"/>
    </record>

    <record id="group_light_user" model="res.groups">
        <field name="name">Warehouse/Field Light User</field>
        <field name="implied_ids" eval="[
            (4, ref('stock.group_stock_user')),
            (4, ref('mrp.group_mrp_user')),
        ]"/>
    </record>
</odoo>
