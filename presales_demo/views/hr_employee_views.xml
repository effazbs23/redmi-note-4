<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_size" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.size</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']//group[@name='schedule']" position="after">
                <group name="payroll_size">
                    <field name="size"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
